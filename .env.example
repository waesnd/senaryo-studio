# Supabase browser client. These values are public; RLS protects data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Canonical deployment URL, e.g. https://studio.example.com (no trailing slash).
# Leave empty locally to use the current origin.
NEXT_PUBLIC_SITE_URL=
# Server-only. Never add NEXT_PUBLIC_ to any variable below.
# Required for media registration and service-only AI settlement.
# AI reservation uses the authenticated JWT; clients cannot refund their own usage.
SUPABASE_SERVICE_ROLE_KEY=
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
